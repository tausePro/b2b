{
  "name": "b2b_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/company-context.test.ts tests/bono-plataforma.test.ts && npm run test:empaques",
    "test:multiempresa:integration": "tsx --test tests/multiempresa.integration.test.ts",
    "test:multiempresa": "npm test && npm run test:multiempresa:integration",
    "test:bono:integration": "node --conditions=react-server --import tsx --test tests/bono-plataforma.integration.test.ts",
    "test:bono:odoo": "node --conditions=react-server --import tsx --test --test-name-pattern=Odoo tests/bono-plataforma.integration.test.ts",
    "test:empaques": "node --conditions=react-server --import tsx --test tests/empaques-tiff.test.ts tests/empaques-personalizados.test.ts tests/empaques-categorias.test.ts tests/empaques-imagenes.test.ts",
    "test:empaques:integration": "node --conditions=react-server --import tsx --test tests/empaques-personalizados.integration.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "0.0.1",
    "sharp": "0.34.5",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
